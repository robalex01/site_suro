# ═══════════════════════════════════════════════════════
#  Snaptech Bot — Environment Variables
#  Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════

# ─── REQUIRED ───────────────────────────────────────────
# Discord bot token (from https://discord.com/developers)
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord application client ID
DISCORD_CLIENT_ID=your_client_id_here

# Neon PostgreSQL connection string
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Shared secret between the bot and the Vercel API
# Must match STAFF_SECRET in your Vercel environment variables
STAFF_SECRET=change_me_to_a_long_random_secret

# ─── RECOMMENDED ────────────────────────────────────────
# Discord server ID — slash commands deploy instantly to this guild
# Without it, commands deploy globally (up to 1 hour delay)
DISCORD_GUILD_ID=your_guild_id_here

# Discord channel ID where request embeds are posted (default/fallback
# for any operator without a dedicated channel below)
# Can also be set at runtime via /config in Discord
DISCORD_LOG_CHANNEL_ID=your_channel_id_here

# Per-operator channels — optional, falls back to DISCORD_LOG_CHANNEL_ID if unset.
# Can also be set at runtime via /config <channel> <operateur> in Discord.
CHANNEL_ORANGE_ID=
CHANNEL_SFR_ID=
CHANNEL_BOUYGUES_ID=
CHANNEL_BELGIUM_ID=

# ─── OPTIONAL ───────────────────────────────────────────
# Base URL of your Vercel deployment (no trailing slash)
# Default: https://snaptech.vercel.app
API_BASE=https://your-project.vercel.app

# Optional ping sent with every new-request message.
# Leave unset to send no ping (recommended under heavy traffic — pinging
# @everyone on every single request floods the channel and can get the
# bot rate-limited). Use "@here" or a role mention like "<@&123456789>".
DISCORD_PING_MESSAGE=
