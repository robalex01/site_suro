{
  "name": "snaptech-web-sidebar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Build-only React/Tailwind/shadcn sidebar for the Access Panel (src/web). Not run as a server — 'npm run build' compiles static JS/CSS that src/web/server.js serves from src/web/public/sidebar/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.383.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
