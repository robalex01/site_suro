# Base de données MySQL / MariaDB (la même que celle du bot Discord)
# Caractères spéciaux du mot de passe à encoder en URL (@ -> %40, # -> %23...).
# Alternative sans encodage : DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME (DB_HOST est prioritaire).
DATABASE_URL=mysql://user:password@host:3306/dbname

# Discord Webhook (optionnel)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Secret staff (bot Discord + API staff-action)
STAFF_SECRET=change_moi_par_un_secret_tres_long_et_aleatoire

# Code PIN panel admin (6 chiffres, donné au staff manager)
STAFF_PIN=123456

# mise a jour constante